# 로컬 docker compose용. 이 파일을 .env로 복사해 값을 채운다 (.env는 커밋하지 않는다)
# 전부 비워 둬도 앱은 동작한다. 서버(온프렘·AWS)는 .env가 아니라 Secret으로 넣는다

# 로그인 토큰 서명 키 (32자 이상). 비우면 재시작할 때마다 로그인이 풀린다
JWT_SECRET=

# mock(기본) / bedrock / fail
AI_MODE=mock

# AI_MODE=bedrock일 때 (로컬에서 실제 AI 시험). 키는 이 파일에만 쓰고 커밋하지 않는다
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 추론 프로필 ID (global.으로 시작). 비우면 코드 기본 모델
BEDROCK_MODEL_ID=

# mock이 실제 AI처럼 응답을 늦추는 시간 (예: 3s). 비우면 0
AI_MOCK_DELAY=
